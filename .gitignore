# ============================================================
#  ClipMind — Variables de entorno de ejemplo
#  Copia este archivo como .env y llena los valores reales.
# ============================================================

# ------------------------------------------------------------
# ANTHROPIC / CLAUDE API
# ------------------------------------------------------------
# Obtén tu API key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo a usar (no cambiar salvo actualización del proyecto)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Tokens máximos por respuesta
ANTHROPIC_MAX_TOKENS=1500

# Versión del prompt
PROMPT_VERSION=v1.0

# ------------------------------------------------------------
# FIREBASE (para versión con backend completo)
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# CONFIGURACIÓN DE LA APP
# ------------------------------------------------------------
# Tamaño máximo de video permitido (en bytes)
# 500MB = 524288000
VITE_MAX_VIDEO_SIZE_BYTES=524288000

# Formatos de video permitidos (separados por coma)
VITE_ALLOWED_VIDEO_FORMATS=video/mp4,video/quicktime,video/webm,video/x-msvideo

# Número de fotogramas a extraer por clip para análisis
VITE_FRAMES_PER_CLIP=4

# Entorno actual
NODE_ENV=development

# URL base de la app (para producción)
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------
# NOTAS IMPORTANTES
# ------------------------------------------------------------
# 1. En la versión HTML standalone, la API key se ingresa
#    directamente en la interfaz y se guarda en memoria.
#
# 2. Para la versión con backend (Node.js/Firebase Functions),
#    ANTHROPIC_API_KEY debe estar SOLO en el servidor,
#    nunca expuesta al navegador.
